# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Option A: Gemini Developer API key (simplest for local development)
GEMINI_API_KEY=

# Option B: Vertex AI through Google Cloud (used when GOOGLE_GENAI_USE_VERTEXAI=true).
# Authenticate with `gcloud auth application-default login` or a service account file.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# With a key as primary, also allow Vertex AI as the fallback (needs GOOGLE_CLOUD_PROJECT):
GEMINI_VERTEX_FALLBACK=false

# Optional explicit model pins. When empty, the engine picks the newest
# available Gemini Pro (reasoning) and Flash (fast) models from the API.
GEMINI_MODEL_REASONING=
GEMINI_MODEL_FAST=

ENGINE_PORT=8787

# Storage: "files" (local engine/data) or "gcp" (Firestore + Cloud Storage bucket).
CONSTRUCTOS_STORE=files
CONSTRUCTOS_BUCKET=

# Optional: Google Maps Platform Solar API key (the plot's own sun and shade in the green check).
MAPS_SOLAR_KEY=
